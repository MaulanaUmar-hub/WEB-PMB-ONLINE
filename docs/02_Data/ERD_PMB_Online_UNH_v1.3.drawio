        <mxCell id="tpage3" value="ERD Fisik - Web PMB Online UNH (PostgreSQL)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="0" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="mpage3" value="Disusun oleh: Bunga Olivia · Direview oleh: Maulana Umar Al-Faroq · Versi 1.3 (revisi P13) · 23 Nov 2026 · v1.2: aturan B3 disetujui CEO · v1.3: DBMS PostgreSQL disetujui CEO (ADR-001) · revisi dibantu AI" style="text;html=1;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="32" width="1600" height="20" as="geometry" /></mxCell>
        <mxCell id="page3_kampus" value="kampus" style="swimlane;fontStyle=1;startSize=28;html=1;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="140" y="110" width="310" height="116" as="geometry" /></mxCell>
        <mxCell id="page3_kampus_k0" value="PK" style="text;html=1;strokeColor=#d0d0d0;fillColor=#f5f5f5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#c00000;" vertex="1" parent="page3_kampus"><mxGeometry x="0" y="28" width="74" height="22" as="geometry" /></mxCell>
