        <mxCell id="page3e25" value="" style="edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.6593;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=12;endSize=12;strokeWidth=1.5;strokeColor=#444444;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="page3_pengguna" target="page3_pendaftaran_ulang"><mxGeometry relative="1" x="0.0000" as="geometry"><Array as="points"><mxPoint x="295.0" y="1400.0" /><mxPoint x="2450.0" y="1400.0" /><mxPoint x="2450.0" y="739.0" /></Array></mxGeometry></mxCell>
        <mxCell id="page3e26" value="" style="edgeStyle=none;html=1;rounded=0;exitX=0.1000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.3673;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=12;endSize=12;strokeWidth=1.5;strokeColor=#444444;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="page3_pendaftaran" target="page3_notifikasi"><mxGeometry relative="1" x="0.0000" as="geometry"><Array as="points"><mxPoint x="1131.0" y="598.0" /><mxPoint x="1023.5" y="598.0" /><mxPoint x="1023.5" y="913.0" /></Array></mxGeometry></mxCell>
        <mxCell id="page3e27" value="" style="edgeStyle=none;html=1;rounded=0;exitX=0.8500;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3352;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=12;endSize=12;strokeWidth=1.5;strokeColor=#444444;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="page3_gelombang" target="page3_ekspor_siakad"><mxGeometry relative="1" x="0.0000" as="geometry"><Array as="points"><mxPoint x="1363.5" y="300.0" /><mxPoint x="1941.0" y="300.0" /><mxPoint x="1941.0" y="941.0" /></Array></mxGeometry></mxCell>
        <mxCell id="page3e28" value="" style="edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.4560;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=12;endSize=12;strokeWidth=1.5;strokeColor=#444444;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="page3_pengguna" target="page3_ekspor_siakad"><mxGeometry relative="1" x="0.0000" as="geometry"><Array as="points"><mxPoint x="295.0" y="1400.0" /><mxPoint x="2410.0" y="1400.0" /><mxPoint x="2410.0" y="963.0" /></Array></mxGeometry></mxCell>
        <mxCell id="page3e29" value="" style="edgeStyle=none;html=1;rounded=0;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=12;endSize=12;strokeWidth=1.5;strokeColor=#444444;fontSize=10;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="page3_ekspor_siakad" target="page3_pendaftaran_ulang"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell>
        <mxCell id="legpage3" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;PK = Primary Key, FK = Foreign Key, UK = Unique&lt;br&gt;UK1 / UK2 = bagian dari UK gabungan (kolom bertanda sama dipasangkan)&lt;br&gt;&lt;i&gt;Teks miring = boleh NULL&lt;/i&gt;&lt;br&gt;Hijau = tabel master, Biru = tabel transaksi, Kuning = entitas pusat&lt;br&gt;Notasi: | = tepat satu, o| = nol atau satu, o&amp;lt; = nol atau banyak, |&amp;lt; = satu atau banyak" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#f9f9f9;spacing=6;" vertex="1" parent="1"><mxGeometry x="140" y="1470" width="520" height="110" as="geometry" /></mxCell>
        <mxCell id="notepage3" value="&lt;b&gt;Constraint fisik (DDL) &amp;amp; catatan DBMS&lt;/b&gt;&lt;br&gt;• CHECK pilihan_prodi: urutan IN (1, 2) · CHECK gelombang: tanggal_tutup &amp;gt;= tanggal_buka&lt;br&gt;• UNIQUE pilihan_prodi (pendaftaran_id, urutan) dan (pendaftaran_id, prodi_id) · UNIQUE gelombang (kampus_id, tahun_akademik, nama_gelombang)&lt;br&gt;• UNIQUE pendaftaran (calon_id, gelombang_id) · UNIQUE pendaftaran_ulang (pilihan_id)&lt;br&gt;• UNIQUE program_studi (kampus_id, nama_prodi), jalur_pendaftaran (kampus_id, nama_jalur), jenis_berkas (kampus_id, nama_jenis)&lt;br&gt;• pembayaran: CREATE UNIQUE INDEX ... ON pembayaran (tagihan_id) WHERE status_verifikasi = &#x27;diterima&#x27; → maks. satu pembayaran diterima per tagihan, ditegakkan di database.&lt;br&gt;• Semua PK memakai GENERATED ALWAYS AS IDENTITY. Kolom waktu memakai TIMESTAMPTZ (zona waktu Asia/Jakarta di aplikasi).&lt;br&gt;• berkas_pendaftaran: INDEX (pendaftaran_id, jenis_berkas_id, diunggah_pada) untuk mengambil unggahan terbaru per jenis berkas.&lt;br&gt;• Validasi kampus yang sama (gelombang, jalur, prodi pada satu pendaftaran) dilakukan di aplikasi.&lt;br&gt;• Semua kolom status memakai VARCHAR(20); daftar nilai tiap status ditulis di kamus data (selaras design system PMB UNH).&lt;br&gt;• &lt;b&gt;DBMS: PostgreSQL&lt;/b&gt;, disetujui CEO 23 Nov 2026 (ADR-001). Syarat: didukung framework Programmer &amp;amp; opsi hosting Network; jika gagal, kembali ke MySQL 8 + trigger (lihat ADR-001)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#f9f9f9;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="1470" width="1670" height="200" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
